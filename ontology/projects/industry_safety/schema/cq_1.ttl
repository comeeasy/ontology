@prefix is:      <http://infiniq.co.kr/2026/industry_safety#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology metadata ────────────────────────────────────────────────────────
<http://infiniq.co.kr/2026/industry_safety/cq_1> a owl:Ontology ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-05-07"^^xsd:date ;
    dcterms:source <https://www.law.go.kr/법령/산업안전보건법/(20240101,19611,20230816)/제17조> ;
    rdfs:label "CQ_1 안전관리자 선임 의무 TBox"@ko .

# ── Classes ──────────────────────────────────────────────────────────────────
is:Workplace a owl:Class ;
    rdfs:label "사업장"@ko ;
    rdfs:comment "산업안전보건법 제2조제3호의 사업장. CQ_1의 검증 대상 단위이며 상시근로자 수 및 안전관리자 선임 여부를 가진다. 근거: 제17조제1항."@ko .

is:Worker a owl:Class ;
    rdfs:label "근로자"@ko ;
    rdfs:comment "산업안전보건법 제2조제1호의 근로자. 상시근로자(PermanentWorker)와 안전관리자(SafetyManager)의 공통 상위 클래스. 근거: 제2조."@ko .

is:PermanentWorker a owl:Class ;
    rdfs:subClassOf is:Worker ;
    rdfs:label "상시근로자"@ko ;
    rdfs:comment "사업장에 상시 고용된 근로자. 50인 이상 여부 판단의 카운팅 대상. 근거: 제17조제1항, 시행령 별표3."@ko .

is:SafetyManager a owl:Class ;
    rdfs:subClassOf is:Worker ;
    rdfs:label "안전관리자"@ko ;
    rdfs:comment "산업안전보건법 제17조제1항에 따라 사업주가 선임해야 하는 안전에 관한 기술적 사항을 관리하는 자. CQ_1의 선임 의무 충족 여부 확인 대상. 근거: 제17조."@ko .

# ── Object Properties ────────────────────────────────────────────────────────
is:employsWorker a owl:ObjectProperty ;
    rdfs:domain is:Workplace ;
    rdfs:range  is:Worker ;
    rdfs:label "근로자고용"@ko ;
    rdfs:comment "사업장이 근로자를 고용하는 관계. 상시근로자 수 산정 및 안전관리자 선임 확인에 사용. 근거: 제17조제1항."@ko .

is:appointsManager a owl:ObjectProperty ;
    rdfs:subPropertyOf is:employsWorker ;
    rdfs:domain is:Workplace ;
    rdfs:range  is:SafetyManager ;
    rdfs:label "안전관리자선임"@ko ;
    rdfs:comment "사업주가 사업장에 안전관리자를 선임하는 관계. CQ_1에서 선임 여부(1명 이상)를 검증하는 핵심 관계. 근거: 제17조제1항."@ko .
