@prefix is: <http://infiniq.co.kr/2026/industry_safety#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

is:r1shape1 a sh:NodeShape ;
    sh:targetClass is:사업장 ;
    sh:report "" ;
    sh:sparql [
        sh:message "제17조 (안전관리자 선임 의무) : 상시근로자 50인 이상 사업장은 안전관리자를 1명 이상 선임해야 한다." ;
        sh:select """
            PREFIX is: <http://infiniq.co.kr/2026/industry_safety#>

            SELECT $this WHERE {
                {
                    SELECT $this (COUNT(?근로자) AS ?수) WHERE {
                        $this is:고용하다 ?근로자 .
                    } GROUP BY $this
                }
                FILTER (?수 >= 50)
                FILTER NOT EXISTS {
                    $this is:선임하다 ?관리자 .
                }
            }
        """
    ] .